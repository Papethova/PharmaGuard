rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || (request.auth.token.email != null && request.auth.token.email.lower() == userId.lower()));
    }

    function isMasterAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'allen32@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['pharmacist', 'technician', 'admin'] &&
             data.status in ['active', 'suspended', 'pending'] &&
             data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status']) &&
             (!('organizationName' in data) || (data.organizationName is string && data.organizationName.size() <= 128)) &&
             (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 64)) &&
             (!('isPhotoRequirementEnabled' in data) || data.isPhotoRequirementEnabled is bool) &&
             (!('migratedFromUid' in data) || (data.migratedFromUid is string && data.migratedFromUid.size() <= 128)) &&
             (!('migratedToUid' in data) || (data.migratedToUid is string && data.migratedToUid.size() <= 128)) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    function isValidSubstance(data) {
      return data.name is string && data.name.size() <= 128 &&
             data.strength is string && data.strength.size() <= 64 &&
             data.schedule in ['C-II', 'C-III', 'C-IV', 'C-V'] &&
             data.ndc is string && data.ndc.size() <= 20 &&
             data.unit is string && data.unit.size() <= 20 &&
             data.currentStock is number &&
             data.keys().hasAll(['name', 'strength', 'schedule', 'currentStock']);
    }

    function isValidTransaction(data) {
      return data.substanceId is string && data.substanceId.size() <= 128 &&
             data.type in ['IN', 'OUT', 'ADJUST', 'VERIFY'] &&
             data.quantity is number &&
             data.performedBy is string && data.performedBy.size() <= 128 &&
             data.timestamp != null &&
             data.keys().hasAll(['substanceId', 'type', 'quantity', 'timestamp', 'performedBy']);
    }

    function isValidStaff(data) {
      return data.name is string && data.name.size() <= 128 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 64)) &&
             data.keys().hasAll(['name']);
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if true;
      allow list: if isMasterAdmin();
      
      allow create: if isMasterAdmin() || (
                      isSignedIn() && 
                      isOwner(userId) && 
                      isValidId(userId) &&
                      isValidUserProfile(incoming()) && 
                      ((request.auth.token.email != null && request.auth.token.email.lower() == 'allen32@gmail.com') ? incoming().status == 'active' : incoming().status in ['active', 'pending'])
                    );
      
      allow update: if isMasterAdmin() || (
        isOwner(userId) && 
        isValidUserProfile(incoming()) && 
        incoming().status == existing().status && 
        incoming().role == existing().role && 
        incoming().email == existing().email &&
        incoming().uid == existing().uid
      );
      
      allow delete: if isMasterAdmin();

      // Sub-collections
      match /substances/{substanceId} {
        allow read: if isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active');
        allow write: if isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active' && 
                        (request.method == 'delete' || isValidSubstance(incoming())) &&
                        isValidId(substanceId));
      }

      match /transactions/{transactionId} {
        allow read: if isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active');
        allow create: if (isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active')) && 
                         isValidTransaction(incoming()) &&
                         isValidId(transactionId) &&
                         incoming().performedBy == request.auth.uid; // Identity Integrity
        allow update, delete: if isMasterAdmin(); 
      }

      match /staff/{staffId} {
        allow read: if isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active');
        allow create: if isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active' && 
                         isValidStaff(incoming()) &&
                         isValidId(staffId));
        allow update: if isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active' && 
                         isValidStaff(incoming()));
        allow delete: if isMasterAdmin() || (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active');
      }
    }
    
    // Testing path
    match /test/connection {
      allow read: if true;
    }
  }
}
